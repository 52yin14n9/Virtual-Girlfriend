ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
SILVERWOLF_MODEL=deepseek-v4-flash
SILVERWOLF_TIMEZONE=Asia/Shanghai
SILVERWOLF_MAX_TOKENS=1000
SILVERWOLF_TEMPERATURE=0.8

# 429/5xx 自动重试次数；总请求次数为 1 + 此值
SILVERWOLF_MAX_RETRIES=3
# 指数退避的初始秒数：1.5、3、6……
SILVERWOLF_RETRY_BASE_SECONDS=1.5


# 后台调度器检查间隔；生产环境推荐 20-60 秒
SILVERWOLF_SCHEDULER_POLL_SECONDS=5

# 多条消息分开发送时的默认间隔
SILVERWOLF_MESSAGE_GAP_SECONDS=0.9


# 使用大模型对日程意图做 JSON 裁决；失败时自动回退本地规则
SILVERWOLF_PLANNER_LLM_ENABLED=true
SILVERWOLF_PLANNER_MIN_CONFIDENCE=0.72
SILVERWOLF_PLANNER_MAX_TOKENS=700
SILVERWOLF_PLANNER_TEMPERATURE=0.1


# Lv24 默认不对普通主动关心做未回复追问；若手动开启，默认 15 分钟后最多追问一次
SILVERWOLF_PROACTIVE_FOLLOW_UP_ENABLED=false
SILVERWOLF_PROACTIVE_FOLLOW_UP_SECONDS=900

# 超过这个时间仍未发送的追问自动过期，避免重启后补发陈旧消息
SILVERWOLF_PROACTIVE_FOLLOW_UP_EXPIRY_SECONDS=3600


# 主动消息选择时避开最近使用过的模板数量
SILVERWOLF_PROACTIVE_TEMPLATE_HISTORY_LIMIT=6



# ==================== Lv18 回复必要性判定 ====================

# 总开关：在主对话 Agent 前先判断当前消息是否需要可见回复
SILVERWOLF_REPLY_GATE_ENABLED=true

# 对本地规则无法确定的消息，使用独立低温度模型判定
SILVERWOLF_REPLY_GATE_LLM_ENABLED=true

# 模型决定“静默”时必须达到的最低置信度；不足则保守回复
SILVERWOLF_REPLY_GATE_MIN_SILENCE_CONFIDENCE=0.78

# 判定 Agent 只输出短 JSON，不需要较大 token
SILVERWOLF_REPLY_GATE_MAX_TOKENS=220
SILVERWOLF_REPLY_GATE_TEMPERATURE=0.0

# 送给判定 Agent 的最近消息数量
SILVERWOLF_REPLY_GATE_CONTEXT_MESSAGES=8

# 可选：单独指定判定模型；留空时沿用 SILVERWOLF_MODEL
SILVERWOLF_REPLY_GATE_MODEL=

# ==================== Lv17 天气与环境感知 ====================

# 天气结果缓存分钟数，避免短时间重复请求
SILVERWOLF_WEATHER_CACHE_MINUTES=30

# 天气与地理编码 HTTP 超时秒数
SILVERWOLF_WEATHER_HTTP_TIMEOUT_SECONDS=10

# 默认常住地点保存在用户动态档案中：江苏省南京市浦口区。
# 后续直接在 QQ 对话里说“以后看苏州天气”即可修改，不要把地点写死在此文件。


# ==================== QQ / OneBot 11 ====================

# QQ 协议登录由 NapCat 等 OneBot 实现负责。
# 银狼只连接 OneBot WebSocket，不读取 QQ 密码。
QQ_BOT_ENABLED=false

# 主人 QQ，必须是纯数字，不要写进源码
MASTER_QQ=

# NapCat 正向 WebSocket 地址。按你的 NapCat 配置修改。
ONEBOT_WS_URL=ws://127.0.0.1:3001

# 必须与 OneBot 实现中的 Access Token 一致
ONEBOT_ACCESS_TOKEN=

# 默认拒绝空 Token；只有完全隔离的本机测试才考虑设为 true
QQ_ALLOW_EMPTY_ONEBOT_TOKEN=false

# 主人重新申请好友时自动同意；其他好友申请默认拒绝
QQ_AUTO_ACCEPT_MASTER_FRIEND=true
QQ_REJECT_NON_MASTER_FRIEND=true
QQ_FRIEND_REQUEST_LOG_ENABLED=true

# 非主人私聊只通知主人，不回复，也不进入模型和记忆
QQ_NOTIFY_NON_MASTER_PRIVATE=true

# 群消息默认关闭，防止群聊刷屏和隐私泄露
QQ_NOTIFY_NON_MASTER_GROUP=false
QQ_ALLOW_MASTER_GROUP_MESSAGE=false

# 紧急关闭：主人发送“/qq shutdown <token>”
QQ_EMERGENCY_COMMAND=/qq shutdown
QQ_EMERGENCY_TOKEN=

ONEBOT_ACTION_TIMEOUT_SECONDS=15
ONEBOT_RECONNECT_INITIAL_SECONDS=2
ONEBOT_RECONNECT_MAX_SECONDS=30
ONEBOT_PING_INTERVAL_SECONDS=20
ONEBOT_PING_TIMEOUT_SECONDS=20

QQ_NOTIFICATION_MAX_CHARS=1000
QQ_EVENT_QUEUE_MAX_SIZE=1000
QQ_AUDIT_LOG_PATH=data/qq/qq_gateway.jsonl

# Lv26: 同轮回复完成度判定与有界续写
SILVERWOLF_COMPLETION_AGENT_ENABLED=true
SILVERWOLF_COMPLETION_LLM_ENABLED=true
SILVERWOLF_COMPLETION_MAX_ROUNDS=2
SILVERWOLF_COMPLETION_MIN_INCOMPLETE_CONFIDENCE=0.72
SILVERWOLF_COMPLETION_MAX_CHARS=12000


# ==================== Lv27 长期任务承诺 ====================

# 总开关：识别"以后每周的周末学 XX"这类多周长期任务，先追问缺的参数再排期
SILVERWOLF_COMMITMENT_ENABLED=true

# 每轮最多问几个信息点（1-3）。默认 2：既不表单化，也不一次堆四个问题
SILVERWOLF_COMMITMENT_CLARIFY_MAX_QUESTIONS=2

# 追问会话多久没补全就作废（小时），过期后不会突然回复旧问题
SILVERWOLF_COMMITMENT_CLARIFY_EXPIRY_HOURS=24

# 用户只说"上午/晚上"没说钟点时的兜底时间
SILVERWOLF_COMMITMENT_DEFAULT_CLOCK=10:00

# 单个承诺允许的最大周数
SILVERWOLF_COMMITMENT_MAX_WEEKS=52

# "每周的周末"是否柔性处理：周末任一天做完就算这一周完成
SILVERWOLF_COMMITMENT_SOFT_WEEKEND=true


# ==================== Lv27 语料库驱动生成 ====================

# 总开关；关闭或无 API Key 时全部退回确定性文案
SILVERWOLF_CORPUS_ENABLED=true

# 生成时参考多少条语料样句
SILVERWOLF_CORPUS_SAMPLES=3

# 普通聊天里注入多少条语气样本（0 表示不注入）
SILVERWOLF_CORPUS_CHAT_SAMPLES=2

# 与语料的最大允许相似度（字符 3-gram Jaccard），超过视为照抄并回退
SILVERWOLF_CORPUS_MAX_OVERLAP=0.35

# 用过的语料样句冷却条数，避免短期反复出现同一批
SILVERWOLF_CORPUS_COOLDOWN=8

# 语料重写专用温度（只影响措辞，不影响事实）
SILVERWOLF_CORPUS_TEMPERATURE=0.85


# ==================== Lv28 记忆加权与遗忘 ====================

# 总开关：关闭后检索退回 Lv27 的纯词法排序，行为完全一致
SILVERWOLF_MEMORY_DECAY_ENABLED=true

# 三因子权重（内部会归一化）：相关性 / 重要度 / 新鲜度
SILVERWOLF_MEMORY_WEIGHT_RELEVANCE=0.55
SILVERWOLF_MEMORY_WEIGHT_IMPORTANCE=0.25
SILVERWOLF_MEMORY_WEIGHT_RECENCY=0.20

# 遗忘曲线的基础稳定度（天）。越大忘得越慢
SILVERWOLF_MEMORY_STABILITY_BASE_DAYS=14

# 是否让模型给记忆打分（默认关闭：重要度是事实判断，交给确定性规则）
SILVERWOLF_RAG_IMPORTANCE_LLM_ENABLED=false


# ==================== Lv28 每周反思 ====================

SILVERWOLF_REFLECTION_ENABLED=true

# 周触发：每周几（0=周一 … 6=周日）、几点之后
SILVERWOLF_REFLECTION_WEEKDAY=6
SILVERWOLF_REFLECTION_HOUR=21

# 累积触发：本周新增记忆重要度合计达到这个值也跑一次
SILVERWOLF_REFLECTION_IMPORTANCE_THRESHOLD=150

# 反思时最多引用多少条记忆作为证据
SILVERWOLF_REFLECTION_MAX_EVIDENCE=12


# ==================== Lv28 沉默回归 ====================

# 用户超过这么多小时没说话，下一条主动消息改为"接着上次的事说"
SILVERWOLF_SILENCE_RETURN_HOURS=18


# ==================== Lv29 语料自我生长 ====================

# 总开关：从对话里采集候选表达（候选默认不生效，必须人工审核）
SILVERWOLF_CORPUS_LEARNING_ENABLED=true

# 是否也学用户的口头表达（默认关闭：避免把玩笑/负面表达学成常规语气）
SILVERWOLF_CORPUS_LEARN_FROM_USER=false

# 语气片段原样复用（≤8 字）；默认关闭，先跑 style 模式观察
SILVERWOLF_CORPUS_PHRASE_MODE=false

# 候选长度窗口
SILVERWOLF_CORPUS_CANDIDATE_MIN_CHARS=5
SILVERWOLF_CORPUS_CANDIDATE_MAX_CHARS=30

# 学来的条目在一次采样里最多占多少比例（防止挤掉手写基线）
SILVERWOLF_CORPUS_LEARNED_SHARE=0.3

# 多少天未被使用且使用次数<3 就淘汰
SILVERWOLF_CORPUS_RETIRE_DAYS=90

# 每个场景的已转正条目上限
SILVERWOLF_CORPUS_SCENE_LIMIT=120

# 隐私过滤（语料会进 prompt，强烈建议保持 true）
SILVERWOLF_CORPUS_PRIVACY_FILTER=true


# ==================== Lv30 Persona 分层与世界书 ====================

# 总开关：关闭后每轮注入整份人设（退回 Lv29 行为）
SILVERWOLF_PERSONA_LAYERS_ENABLED=true

# 核心人设建议上限（字符），超了说明该往模块里搬
SILVERWOLF_PERSONA_CORE_MAX_CHARS=4000

# 单轮注入总量上限（核心 + 命中模块），超了按优先级丢模块
SILVERWOLF_PERSONA_BUDGET_CHARS=8000


# ==================== Lv30 概率化主动时机 ====================

# 早/中/晚关心在窗口内做小幅抖动，避免准点打卡感
SILVERWOLF_PROACTIVE_JITTER_ENABLED=true
SILVERWOLF_PROACTIVE_JITTER_MINUTES=10

# 你手动改过某个时间槽后，这么多天内该槽位保持准点
SILVERWOLF_PROACTIVE_PINNED_DAYS=7


# ==================== Lv31 主动消息语料化 ====================

# 总开关：早/中/晚关心、话题回访改由「语料 + 模型」重写
# 关闭后完全等于 Lv30 行为（模板池 + 确定性拼接）
SILVERWOLF_PROACTIVE_SPEECH_ENABLED=true

# 单条生成硬超时（秒）。超时立即用确定性文案，绝不卡住调度循环
SILVERWOLF_PROACTIVE_SPEECH_TIMEOUT_SECONDS=8

# 主动消息长度上限
SILVERWOLF_PROACTIVE_SPEECH_MAX_CHARS=80

# 哪些场景允许语料化（morning,noon,evening,callback,follow_up,self_share）
# 注意：正式提醒（吃药/睡觉/日程/长期承诺）永远不使用语料化
SILVERWOLF_PROACTIVE_SPEECH_SCENES=morning,noon,evening,callback,follow_up,self_share

# 生成时参考多少条语料样句
SILVERWOLF_PROACTIVE_SPEECH_SAMPLES=3


# ==================== Lv32 她自己的事（自我分享） ====================

# 总开关：早/中/晚关心时，偶尔顺口讲一句她这几天的事
SILVERWOLF_SELF_SHARE_ENABLED=true

# 每周最多讲几次（硬上限，0 = 关闭）
SILVERWOLF_SELF_SHARE_PER_WEEK=2

# 只讲这么多天以前的事（当天的事不讲，避免像日程汇报）
SILVERWOLF_SELF_SHARE_MIN_AGE_DAYS=1

# 太久远的事不讲（避免"翻旧账"感）
SILVERWOLF_SELF_SHARE_MAX_AGE_DAYS=10

# "没做成"这类事件的最小间隔天数（防止讲得丧）
SILVERWOLF_SELF_SHARE_SETBACK_DAYS=10


# ==================== Lv32 语料隐式正向信号 ====================

# 她说完话后你继续聊 → 给上一句记一次弱正向（只影响 /corpus review 排序）
# 绝不自动转正；你不回复也不会记任何负面
SILVERWOLF_CORPUS_IMPLICIT_SIGNAL_ENABLED=true

# 多少分钟之内继续说才算"继续聊"
SILVERWOLF_CORPUS_IMPLICIT_WINDOW_MINUTES=10
